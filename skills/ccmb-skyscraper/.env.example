# Skyscraper Bonus — optional API keys
# All keys optional. Zero-key install works in WebSearch-only mode.

# Apify REST API (richer Apify Store metadata + reddit/youtube scrape backends)
APIFY_API_TOKEN=

# YouTube Data API v3 (description + comments enrichment)
YOUTUBE_API_KEY=

# Reddit user agent (only if you switch to direct Reddit JSON API)
REDDIT_USER_AGENT=

# Daily Apify compute budget in USD (default 0.50)
SKYSCRAPER_BUDGET_USD=0.50
